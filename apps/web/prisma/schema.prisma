generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// An account. Buyers and creators share one model: anyone signed in can buy, review and sell.
/// Sign-in is passwordless (a one-time code sent to the email).
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  /// Shown on reviews and as the creator on product pages. Empty until the person sets it.
  name      String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
  apiKeys   ApiKey[]
  apps      App[]
  orders    Order[]
  reviews   Review[]
}

/// One-time sign-in code. Only the latest code per email is kept; it is deleted once used.
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  /// HMAC-SHA256 (APP_SECRET_KEY) of email + code; the code itself is never stored.
  codeHash  String
  /// Wrong guesses so far; the code stops working after LOGIN_CODE_MAX_ATTEMPTS.
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  /// sha256 of the cookie token; the raw token is never stored.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Secret key for the creator REST API (server-to-server only, never ship it in an app binary).
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// First chars of the key, shown in the dashboard ("dh_sk_ab12…").
  prefix     String
  hash       String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

enum Platform {
  MACOS
  WINDOWS
  LINUX
}

/// What a product is. Drives store filters and copy; only SOFTWARE has a platform.
enum ProductKind {
  SOFTWARE
  EBOOK
  COURSE
  TEMPLATE
  GRAPHICS
  AUDIO
  VIDEO
  FONT
  OTHER
}

enum AppStatus {
  DRAFT
  PUBLISHED
}

/// A product for sale: software, an ebook, a template, anything delivered as a file.
/// (Named App for historical reasons; `appId` is part of the public license API.)
model App {
  id                   String      @id @default(cuid())
  ownerId              String
  owner                User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  slug                 String      @unique
  name                 String
  tagline              String
  description          String
  iconUrl              String?
  websiteUrl           String?
  kind                 ProductKind @default(SOFTWARE)
  /// Only set for SOFTWARE.
  platform             Platform?
  /// 0 means free: the download is claimed with an email, no payment provider involved.
  priceCents           Int
  currency             String      @default("usd")
  status               AppStatus   @default(DRAFT)
  /// Issue a license key with every order (for products that check one, like software).
  licenseKeys          Boolean     @default(true)
  /// Devices a single license can be activated on.
  maxActivations       Int         @default(3)
  /// Ed25519 public key (raw 32 bytes, base64). Embedded in the app to verify license tokens offline.
  signingPublicKey     String
  /// Ed25519 private key (PKCS8 DER), AES-256-GCM encrypted with APP_SECRET_KEY.
  signingPrivateKeyEnc String
  polarProductId       String?
  /// Price the Polar product was last synced with; used to detect price changes.
  polarPriceCents      Int?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  releases             Release[]
  media                Media[]
  orders               Order[]
  licenses             License[]
  reviews              Review[]

  @@index([ownerId])
  @@index([status])
}

model Release {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  version   String
  notes     String   @default("")
  /// Object key in storage (R2/S3 or local).
  fileKey   String   @unique
  fileName  String
  fileSize  Int      @default(0)
  /// Set once the upload has been confirmed.
  uploaded  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([appId, version])
  @@index([appId, createdAt])
}

enum MediaKind {
  IMAGE
  VIDEO
}

/// A screenshot or demo video shown on the product page.
model Media {
  id          String    @id @default(cuid())
  appId       String
  app         App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  kind        MediaKind
  /// Object key in storage (R2/S3 or local).
  fileKey     String    @unique
  contentType String
  fileSize    Int       @default(0)
  /// Gallery order, lowest first.
  position    Int       @default(0)
  /// Set once the upload has been confirmed.
  uploaded    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([appId, position])
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
}

model Order {
  id                     String      @id @default(cuid())
  appId                  String
  app                    App         @relation(fields: [appId], references: [id], onDelete: Restrict)
  status                 OrderStatus @default(PENDING)
  provider               String
  checkoutId             String      @unique
  providerOrderId        String?     @unique
  /// Set when the buyer was signed in at checkout. Orders also show up in the account whose email matches.
  userId                 String?
  user                   User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                  String?
  amountCents            Int
  currency               String
  platformFeeCents       Int         @default(0)
  creatorEarningsCents Int         @default(0)
  /// Unguessable token used for the download link in the receipt email.
  downloadToken          String      @unique
  paidAt                 DateTime?
  createdAt              DateTime    @default(now())
  license                License?

  @@index([appId, status])
  @@index([userId])
  @@index([email])
}

enum LicenseStatus {
  ACTIVE
  REVOKED
}

model License {
  id             String        @id @default(cuid())
  key            String        @unique
  appId          String
  app            App           @relation(fields: [appId], references: [id], onDelete: Cascade)
  orderId        String?       @unique
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  email          String
  status         LicenseStatus @default(ACTIVE)
  maxActivations Int
  note           String?
  createdAt      DateTime      @default(now())
  activations    Activation[]

  @@index([appId])
  @@index([email])
}

model Activation {
  id         String   @id @default(cuid())
  licenseId  String
  license    License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  deviceId   String
  deviceName String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@unique([licenseId, deviceId])
}

/// A buyer's rating of a product. One per account per product; only buyers with a paid order can post.
model Review {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1 to 5 stars.
  rating    Int
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, userId])
  @@index([appId, createdAt])
}

/// Processed payment-provider webhook ids (idempotency).
model WebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}
