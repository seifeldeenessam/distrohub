# --- Core ---
DATABASE_URL="postgresql://distrohub:distrohub@localhost:5432/distrohub"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# 32-byte base64 key used to encrypt per-app signing keys and sign local storage URLs.
# Generate: openssl rand -base64 32
APP_SECRET_KEY=""
# Platform commission in basis points (1000 = 10%).
PLATFORM_FEE_BPS="1000"

# --- Payments: "polar" or "mock" (mock = fake checkout page, for local dev) ---
PAYMENTS_PROVIDER="mock"
# Production refuses the mock provider unless this is "true" (demo deployments only).
ALLOW_MOCK_PAYMENTS="false"
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
# "sandbox" or "production"
POLAR_SERVER="sandbox"

# --- Storage: "s3" (Cloudflare R2 / AWS S3) or "local" (./.storage, dev only) ---
STORAGE_DRIVER="local"
S3_ENDPOINT=""            # R2: https://<account_id>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Email: Resend. Leave empty to log emails to the console. ---
RESEND_API_KEY=""
EMAIL_FROM="DistroHub <licenses@example.com>"
